# API 基礎網址配置
# 請根據您的後端 API 實際位置修改

# 開發環境 - .NET HTTPS API
VITE_API_BASE_URL=https://localhost:7177/api

# 其他常見配置：
# VITE_API_BASE_URL=http://localhost:5001/api  # .NET HTTPS
# VITE_API_BASE_URL=http://localhost:3000/api  # Express.js
# VITE_API_BASE_URL=http://localhost:8080/api  # Spring Boot
# VITE_API_BASE_URL=/api                        # 同源請求
